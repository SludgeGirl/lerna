[Unit]
Description=Lerna Tailscale agent - %i
Documentation=https://codeberg.org/sludge/lerna
Wants=network-pre.target
After=network-pre.target NetworkManager.service systemd-resolved.service

[Service]
EnvironmentFile=/etc/default/tailscaled
ExecStart=/usr/sbin/tailscaled --state=/var/lib/lerna/lerna-%i-tailscaled.state --socket=/run/lerna/lerna-%i-tailscaled.sock --port=${PORT} $FLAGS
ExecStopPost=/usr/sbin/tailscaled --cleanup

Restart=on-failure

RuntimeDirectory=lerna-%i
RuntimeDirectoryMode=0755
StateDirectory=lerna-%i
StateDirectoryMode=0700
CacheDirectory=lerna-%i
CacheDirectoryMode=0750
Type=notify
NetworkNamespacePath=/run/netns/lerna-%i

[Install]
WantedBy=multi-user.target
